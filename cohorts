const FILTERS = {tier:'all', bucket:'all', tg:'all', cty:'all'};
let VIEW = 'cards';
let TAB = 'all';

function tier(s,f,l){ if(f==='Megan'&&l==='Purdy') return 'hot'; if(s>=75) return 'warm'; return 'cold'; }
function scls(s,f,l){ const t=tier(s,f,l); return t==='hot'?'sh':t==='warm'?'sw2':'sc'; }
function tlabel(s,f,l){ const t=tier(s,f,l); return t==='hot'?'🔴 Hot':t==='warm'?'🟡 Warm':'⚪ Cold'; }
function tclass(s,f,l){ const t=tier(s,f,l); return t==='hot'?'thot':t==='warm'?'twarm':'tcold'; }
function flag(c){ return c==='Canada'?'🇨🇦':c==='United States'?'🇺🇸':'🌎'; }

function buildTitleFilters(){
  const others = LEADS.filter(l=>l.industry_bucket==='Others');
  const tgs = [...new Set(others.map(l=>l.title_group))].sort();
  document.getElementById('title-f').innerHTML =
    `<button class="fb active" data-f="tg" data-v="all" onclick="sf('tg','all',this)">All <span class="cnt">${others.length}</span></button>` +
    tgs.map(tg=>{
      const cnt = others.filter(l=>l.title_group===tg).length;
      const safe = tg.replace(/'/g,"\\'");
      return `<button class="fb" data-f="tg" data-v="${tg}" onclick="sf('tg','${safe}',this)">${tg} <span class="cnt">${cnt}</span></button>`;
    }).join('');
}

function filtered(){
  const q = document.getElementById('searchInput').value.toLowerCase();
  return LEADS.filter(l=>{
    if(TAB==='ind' && l.industry_bucket==='Others') return false;
    if(TAB==='title' && l.industry_bucket!=='Others') return false;
    if(FILTERS.tier!=='all' && tier(l.score,l.first,l.last)!==FILTERS.tier) return false;
    if(FILTERS.bucket!=='all' && l.industry_bucket!==FILTERS.bucket) return false;
    if(FILTERS.tg!=='all' && l.title_group!==FILTERS.tg) return false;
    if(FILTERS.cty!=='all'){
      if(FILTERS.cty==='Other'){ if(l.country==='Canada'||l.country==='United States') return false; }
      else if(l.country!==FILTERS.cty) return false;
    }
    if(q){
      const b=[l.first,l.last,l.company,l.title,l.industry,l.industry_bucket,l.title_group||''].join(' ').toLowerCase();
      if(!b.includes(q)) return false;
    }
    return true;
  });
}

function sf(type,val,btn){
  FILTERS[type]=val;
  document.querySelectorAll(`[data-f="${type}"]`).forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  render();
}

function resetFilters(){
  Object.keys(FILTERS).forEach(k=>FILTERS[k]='all');
  document.getElementById('searchInput').value='';
  document.querySelectorAll('.fb').forEach(b=>b.classList.toggle('active',b.dataset.v==='all'));
  render();
}

function setTab(t){
  TAB=t;
  ['all','ind','title'].forEach(id=>document.getElementById('tab-'+id).classList.toggle('active',id===t));
  render();
}

function render(){
  const data = filtered();
  document.getElementById('rc').textContent = data.length;
  if(VIEW==='cards') renderCards(data);
  else renderTable(data);
}

function cardHTML(l){
  const bucketTag = l.industry_bucket==='Others'
    ? `<span class="tag tg">${l.title_group}</span>`
    : `<span class="tag ti">${l.industry_bucket}</span>`;
  return `<div class="card" onclick="showDetail(${l.id})">
    <div class="card-top">
      <div><div class="cn">${l.first} ${l.last}</div><div class="cc">${l.company}</div></div>
      <div class="sb ${scls(l.score,l.first,l.last)}">${l.score}</div>
    </div>
    <div class="ctitle">${l.title}</div>
    <div class="card-tags">
      ${bucketTag}
      <span class="tag tc">${flag(l.country)} ${l.country||'—'}</span>
    </div>
    <div class="card-footer">
      <span style="font-size:10px;color:var(--muted)">${l.industry_bucket==='Others'?`<span class="tag tind" style="font-size:9px">${l.industry}</span>`:''}</span>
      <span style="font-size:10px;font-weight:600" class="${tclass(l.score,l.first,l.last)}">${tlabel(l.score,l.first,l.last)}</span>
    </div>
  </div>`;
}

function renderCards(data){
  const g = document.getElementById('cardGrid');
  if(!data.length){ g.innerHTML='<div class="empty" style="grid-column:1/-1"><p style="font-size:24px;margin-bottom:8px">🔍</p><p>No leads match your filters.</p></div>'; return; }

  if(TAB==='title'){
    const groups = [...new Set(data.map(l=>l.title_group))].sort();
    g.innerHTML =
      `<div class="tab-hint" style="grid-column:1/-1"><strong>Job Title Cohort — 25 leads.</strong> These leads fall outside the 4 industry cohorts. They will receive persona-specific messaging based on their job title role rather than their industry vertical. Their actual industry is shown on each card for reference.</div>` +
      groups.map(grp=>{
        const gLeads = data.filter(l=>l.title_group===grp);
        return `<div class="group-header"><span class="gh-label">${grp}</span><span class="gh-cnt">${gLeads.length} lead${gLeads.length>1?'s':''}</span><span class="gh-line"></span></div>`
          + gLeads.map(l=>cardHTML(l)).join('');
      }).join('');
  } else {
    g.innerHTML = data.map(l=>cardHTML(l)).join('');
  }
}

function renderTable(data){
  const w = document.getElementById('tableWrap');
  if(!data.length){ w.innerHTML='<div class="empty"><p>No leads match your filters.</p></div>'; return; }
  w.innerHTML=`<table><thead><tr><th>Name</th><th>Company</th><th>Job Title</th><th>Cohort</th><th>Industry (actual)</th><th>Score</th><th>Country</th></tr></thead><tbody>`+
    data.map(l=>`<tr onclick="showDetail(${l.id})">
      <td>${l.first} ${l.last}</td>
      <td>${l.company}</td>
      <td style="max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${l.title}</td>
      <td>${l.industry_bucket==='Others'?`<span class="tag tg" style="font-size:10px">${l.title_group}</span>`:`<span class="tag ti" style="font-size:10px">${l.industry_bucket}</span>`}</td>
      <td><span class="tag tind" style="font-size:10px">${l.industry}</span></td>
      <td><span class="sb ${scls(l.score,l.first,l.last)}" style="width:auto;height:auto;padding:3px 8px;border-radius:5px;font-size:11px">${l.score}</span></td>
      <td>${flag(l.country)} ${l.country||'—'}</td>
    </tr>`).join('')+'</tbody></table>';
}

function showDetail(id){
  const l = LEADS[id];
  document.getElementById('dp').classList.remove('hidden');
  const t = tier(l.score,l.first,l.last);
  const tc2 = t==='hot'?'thot':t==='warm'?'twarm':'tcold';
  const tl = t==='hot'?'Hot (form fill)':t==='warm'?'Warm (75+)':'Cold';
  const isOther = l.industry_bucket==='Others';
  const msgBadge = isOther
    ? `<span class="msg-badge mb-title">Job Title Cohort — ${l.title_group}</span>`
    : `<span class="msg-badge mb-ind">Industry Cohort — ${l.industry_bucket}</span>`;
  const action = t==='hot'
    ? 'HOT LEAD — filled out contact form. Immediate action: enrich in AudienceAI, update Pardot fields, add to static list and ping sales.'
    : t==='warm'
    ? 'Warm lead (75+). Cohort candidate — enrich in AudienceAI to identify trigger type and enrol in cohort program.'
    : 'Cold lead. Keep in Stage 1 vertical nurture until score reaches 75+.';

  document.getElementById('di').innerHTML=`
    <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:14px">
      <div><div class="dn">${l.first} ${l.last}</div><div class="dt">${l.title}<br><strong>${l.company}</strong></div></div>
      <button class="close-btn" onclick="closeDetail()">✕</button>
    </div>
    <div class="dsr">
      <div class="dsb ${scls(l.score,l.first,l.last)}">${l.score}</div>
      <div class="dstx">
        <div class="dsl">Pardot Score</div>
        <div class="dss ${tc2}">${tl}</div>
        <div style="margin-top:5px">${msgBadge}</div>
      </div>
    </div>
    <div class="crec"><div class="crect">Action</div><div class="crecv">${action}</div></div>
    <div class="ds2">
      <div class="dst2">Lead details</div>
      <div class="dr"><span class="dl">Country</span><span class="dv">${flag(l.country)} ${l.country||'—'}</span></div>
      <div class="dr"><span class="dl">Email</span><span class="dv" style="font-size:10px;word-break:break-all">${l.email}</span></div>
    </div>
    <div class="ds2">
      <div class="dst2">Industry (enriched)</div>
      <div class="dr"><span class="dl">Actual industry</span><span class="dv"><span class="tag tind">${l.industry}</span></span></div>
      <div class="dr"><span class="dl">Cohort bucket</span><span class="dv"><span class="tag ${isOther?'tg':'ti'}">${l.industry_bucket}</span></span></div>
      <div class="dr"><span class="dl">Reason</span><span class="dv" style="color:var(--muted);font-size:10px;font-weight:400">${l.industry_reason}</span></div>
    </div>
    ${isOther?`<div class="ds2"><div class="dst2">Job title messaging</div><div class="dr"><span class="dl">Title group</span><span class="dv"><span class="tag tg">${l.title_group}</span></span></div><div class="dr"><span class="dl">Approach</span><span class="dv" style="font-size:10px;color:var(--muted)">Persona-specific messaging targeting ${l.title_group} pain points — industry-agnostic.</span></div></div>`:''}
  `;
}

function closeDetail(){ document.getElementById('dp').classList.add('hidden'); }

function setView(v){
  VIEW=v;
  document.getElementById('btnC').classList.toggle('active',v==='cards');
  document.getElementById('btnT').classList.toggle('active',v==='table');
  document.getElementById('cardGrid').style.display=v==='cards'?'grid':'none';
  document.getElementById('tableWrap').style.display=v==='table'?'block':'none';
  render();
}

buildTitleFilters();
render();
</script>
