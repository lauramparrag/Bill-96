<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bill 96 Campaign Cohort Strategy</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{--bg:#f7f6f2;--surface:#fff;--border:#e8e4dc;--text:#1a1814;--muted:#9a9488;--accent:#2d6a4f;--al:#e8f5ee;--a3:#264653;--hot:#e63946;--hotl:#fdecea;--warm:#f4a261;--warml:#fef4e8;--cold:#adb5bd;--coldl:#f4f5f6;--coral:#e76f51;--corall:#fdf0eb;--purple:#6c3fc5;--purplel:#f0eaff;--purpleb:#c9b8f0}
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:'Poppins',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;font-size:13px}

  /* HEADER */
  .header{background:var(--a3);padding:22px 32px;display:flex;align-items:flex-end;justify-content:space-between;gap:20px}
  .hey{font-size:10px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:rgba(255,255,255,.45);margin-bottom:4px}
  .htitle{font-size:22px;font-weight:800;color:#fff;letter-spacing:-.03em}
  .htitle span{color:#a8dadc}
  .hsub{font-size:11px;color:rgba(255,255,255,.4);margin-top:4px}
  .hstats{display:flex;gap:14px}
  .hs{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);border-radius:10px;padding:10px 14px;text-align:center;min-width:76px}
  .hs-n{font-size:19px;font-weight:700;color:#fff;line-height:1;margin-bottom:3px}
  .hs-l{font-size:9px;font-weight:500;color:rgba(255,255,255,.4);text-transform:uppercase;letter-spacing:.1em}

  /* COHORT BANNER */
  .cohort-banner{background:#1a3a2a;border-bottom:1px solid #2d6a4f40;padding:10px 32px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
  .cb-label{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.14em;color:rgba(255,255,255,.4);margin-right:4px}
  .cohort-pill{display:flex;align-items:center;gap:6px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:20px;padding:4px 12px;font-size:11px;font-weight:600;color:#fff}
  .cohort-pill .dot{width:7px;height:7px;border-radius:50%;flex-shrink:0}
  .cp1{background:#a8dadc} .cp2{background:#f4a261} .cp3{background:#e9c46a} .cp4{background:#90be6d} .cp5{background:#c9b8f0}
  .cohort-arrow{color:rgba(255,255,255,.25);font-size:12px}

  /* LAYOUT */
  .body{display:flex;height:calc(100vh - 122px);overflow:hidden}

  /* SIDEBAR */
  .sidebar{width:224px;flex-shrink:0;background:var(--surface);border-right:1px solid var(--border);overflow-y:auto;padding:14px 11px;display:flex;flex-direction:column;gap:16px}
  .ft{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.14em;color:var(--muted);margin-bottom:6px}
  .fb{display:flex;align-items:center;justify-content:space-between;width:100%;padding:6px 9px;background:transparent;border:1px solid transparent;border-radius:6px;color:var(--muted);font-family:'Poppins',sans-serif;font-size:11.5px;cursor:pointer;text-align:left;transition:all .15s;margin-bottom:2px}
  .fb:hover{background:var(--bg);color:var(--text)}
  .fb.active{background:var(--al);color:var(--accent);border-color:#b7e4c7;font-weight:600}
  .fb .cnt{font-size:10px;background:var(--bg);border-radius:4px;padding:1px 5px;color:var(--muted)}
  .fb.active .cnt{background:#b7e4c7;color:var(--accent)}
  .sw{position:relative}
  .sw input{width:100%;padding:7px 9px 7px 28px;background:var(--bg);border:1px solid var(--border);border-radius:7px;font-family:'Poppins',sans-serif;font-size:12px;color:var(--text);outline:none;transition:border-color .2s}
  .sw input:focus{border-color:var(--accent)}
  .si{position:absolute;left:8px;top:50%;transform:translateY(-50%);font-size:11px;color:var(--muted);pointer-events:none}
  .sidebar-section-note{font-size:10px;color:var(--muted);font-style:italic;padding:0 2px;margin-bottom:4px;line-height:1.4}
  .rb{width:100%;padding:6px;background:transparent;border:1px solid var(--border);border-radius:6px;color:var(--muted);font-family:'Poppins',sans-serif;font-size:11px;cursor:pointer;transition:all .15s}
  .rb:hover{border-color:var(--coral);color:var(--coral)}

  /* MAIN */
  .main{flex:1;overflow-y:auto;padding:18px 22px}
  .tabs{display:flex;gap:0;margin-bottom:18px;border-bottom:2px solid var(--border)}
  .tab{padding:9px 18px;background:transparent;border:none;font-family:'Poppins',sans-serif;font-size:12px;font-weight:500;color:var(--muted);cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-2px;transition:all .15s}
  .tab:hover{color:var(--text)}
  .tab.active{color:var(--accent);border-bottom-color:var(--accent);font-weight:700}
  .tab-badge{font-size:10px;background:var(--bg);border-radius:10px;padding:1px 7px;margin-left:5px;color:var(--muted)}
  .tab.active .tab-badge{background:var(--al);color:var(--accent)}
  .toolbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
  .rc{font-size:12px;color:var(--muted)} .rc strong{color:var(--text)}
  .vbtns{display:flex;gap:4px}
  .vb{padding:5px 11px;background:var(--surface);border:1px solid var(--border);border-radius:6px;font-family:'Poppins',sans-serif;font-size:11px;color:var(--muted);cursor:pointer;transition:all .15s}
  .vb.active{background:var(--a3);color:#fff;border-color:var(--a3)}

  /* CARDS */
  .card-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(288px,1fr));gap:11px}
  .card{background:var(--surface);border:1px solid var(--border);border-radius:11px;padding:14px;cursor:pointer;transition:all .2s}
  .card:hover{border-color:var(--accent);box-shadow:0 4px 16px rgba(45,106,79,.08);transform:translateY(-1px)}
  .card-top{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:8px;gap:8px}
  .cn{font-size:13px;font-weight:700;color:var(--text);line-height:1.2}
  .cc{font-size:11px;color:var(--muted);margin-top:2px;font-weight:500}
  .sb{flex-shrink:0;font-size:13px;font-weight:800;width:40px;height:40px;border-radius:9px;display:flex;align-items:center;justify-content:center}
  .sh{background:var(--hotl);color:var(--hot)} .sw2{background:var(--warml);color:#c1440e} .sc{background:var(--coldl);color:var(--cold)}
  .ctitle{font-size:11px;color:#555;margin-bottom:9px;line-height:1.4;font-weight:500}
  .card-tags{display:flex;flex-wrap:wrap;gap:4px;margin-bottom:8px}
  .tag{font-size:10px;font-weight:500;padding:2px 7px;border-radius:4px}
  .ti{background:#e8f5ee;color:var(--accent);border:1px solid #b7e4c7}
  .tc{background:#eef2f7;color:var(--a3);border:1px solid #c5d3e0}
  .tg{background:var(--purplel);color:var(--purple);border:1px solid var(--purpleb)}
  .tind{background:#fff8e6;color:#b8860b;border:1px solid #f9c74f80}
  .card-footer{display:flex;align-items:center;justify-content:space-between}

  /* GROUP HEADERS (job title tab) */
  .group-header{display:flex;align-items:center;gap:10px;margin:20px 0 10px;grid-column:1/-1}
  .group-header:first-of-type{margin-top:0}
  .gh-label{font-size:12px;font-weight:700;color:var(--text)}
  .gh-cnt{font-size:10px;background:var(--purplel);color:var(--purple);border:1px solid var(--purpleb);border-radius:10px;padding:1px 8px;font-weight:600}
  .gh-line{flex:1;height:1px;background:var(--border)}

  /* TITLE TAB HINT */
  .tab-hint{background:var(--purplel);border:1px solid var(--purpleb);border-radius:8px;padding:10px 14px;margin-bottom:16px;font-size:11px;color:#4a2d8a;line-height:1.5;grid-column:1/-1}
  .tab-hint strong{font-weight:700}

  /* DETAIL PANEL */
  .detail-panel{width:350px;flex-shrink:0;background:var(--surface);border-left:1px solid var(--border);overflow-y:auto;transition:width .25s}
  .detail-panel.hidden{width:0;overflow:hidden}
  .di{padding:20px;min-width:350px}
  .dn{font-size:17px;font-weight:800;color:var(--text);margin-bottom:2px}
  .dt{font-size:11px;color:var(--muted);margin-bottom:14px;line-height:1.5}
  .dsr{display:flex;align-items:center;gap:10px;margin-bottom:16px}
  .dsb{font-size:24px;font-weight:800;width:56px;height:56px;border-radius:11px;display:flex;align-items:center;justify-content:center}
  .dstx{flex:1}
  .dsl{font-size:10px;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);margin-bottom:3px}
  .dss{font-size:12px;font-weight:600}
  .thot{color:var(--hot)} .twarm{color:#c1440e} .tcold{color:var(--cold)}
  .msg-badge{display:inline-block;font-size:10px;font-weight:600;padding:3px 9px;border-radius:5px;margin-top:5px}
  .mb-ind{background:var(--al);color:var(--accent);border:1px solid #b7e4c7}
  .mb-title{background:var(--purplel);color:var(--purple);border:1px solid var(--purpleb)}
  .ds2{margin-bottom:14px}
  .dst2{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.14em;color:var(--muted);margin-bottom:7px;padding-bottom:5px;border-bottom:1px solid var(--border)}
  .dr{display:flex;gap:8px;margin-bottom:6px;align-items:flex-start}
  .dl{font-size:11px;color:var(--muted);font-weight:500;min-width:80px;flex-shrink:0;padding-top:1px}
  .dv{font-size:11px;color:var(--text);font-weight:500;line-height:1.4}
  .crec{background:var(--al);border:1px solid #b7e4c7;border-radius:8px;padding:11px;margin-bottom:14px}
  .crect{font-size:10px;font-weight:700;color:var(--accent);text-transform:uppercase;letter-spacing:.1em;margin-bottom:5px}
  .crecv{font-size:11px;color:#2d4a3a;line-height:1.6}
  .close-btn{float:right;background:var(--bg);border:1px solid var(--border);border-radius:5px;padding:3px 9px;font-size:11px;color:var(--muted);cursor:pointer;font-family:'Poppins',sans-serif;transition:all .15s}
  .close-btn:hover{border-color:var(--coral);color:var(--coral)}

  /* TABLE */
  .table-wrap{overflow-x:auto}
  table{width:100%;border-collapse:collapse;font-size:12px}
  thead th{background:var(--surface);border-bottom:2px solid var(--border);padding:9px 11px;text-align:left;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);white-space:nowrap;position:sticky;top:0}
  tbody tr{border-bottom:1px solid var(--border);cursor:pointer;transition:background .1s}
  tbody tr:hover{background:var(--bg)}
  tbody td{padding:9px 11px;color:#555;vertical-align:middle}
  tbody td:first-child{color:var(--text);font-weight:600}
  .empty{text-align:center;padding:50px 20px;color:var(--muted)}
  ::-webkit-scrollbar{width:4px;height:4px}
  ::-webkit-scrollbar-track{background:transparent}
  ::-webkit-scrollbar-thumb{background:var(--border);border-radius:2px}
</style>
</head>
